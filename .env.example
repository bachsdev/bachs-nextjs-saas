# Bachs sandbox. Production is https://api.bachs.io with an sk_live_ key.
BACHS_ENVIRONMENT=sandbox
BACHS_API_URL=https://sandbox-api.bachs.io
BACHS_API_KEY=sk_sandbox_...

# Printed by `npm run listen` for local development. In production, use the
# signing secret of the webhook endpoint you register in the dashboard.
BACHS_WEBHOOK_SECRET=whsec_...

# Printed by `npm run setup:products`.
BACHS_PRO_MONTHLY=prod_...
BACHS_PRO_YEARLY=prod_...

# Where this app runs. Checkout redirects are configured separately below.
APP_URL=http://localhost:3000

# The demo user's email. Replace lib/auth.ts with your own authentication.
DEMO_USER_EMAIL=you@example.com

# Optional checkout redirects must be public URLs. Bachs refuses localhost
# and private IPs even in sandbox. Leave these empty for a fully local app;
# after checkout, return to localhost:3000 yourself to see webhook-driven access.
# For a public deployment or tunnel, set its /billing/success and / URLs.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
