{
  "name": "bachs-nextjs-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Starter template: a Next.js SaaS with Bachs subscriptions, webhooks and the customer portal.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:products": "node scripts/create-products.mjs",
    "listen": "bachs listen --forward-to localhost:3000/api/webhooks/bachs --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed",
    "test:smoke": "node scripts/smoke.mjs",
    "verify": "npm test && npm run typecheck && npm run build && npm run test:smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bachs/sdk": "2.0.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
